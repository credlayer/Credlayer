# Copy to .env and fill in for local development.

ENVIRONMENT=development
LOG_LEVEL=INFO

API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173"]

# Local PostgreSQL
DATABASE_URL=postgresql+asyncpg://credlayer:credlayer@localhost:5432/credlayer

# For Supabase (uses pgbouncer - requires prepared_statement_cache_size=0):
# DATABASE_URL=postgresql+asyncpg://postgres:password@db.xxx.supabase.co:5432/postgres?prepared_statement_cache_size=0
# Note: The backend auto-detects "supabase" in URL and disables statement cache automatically

# Redis is optional - leave empty or omit to disable caching
REDIS_URL=redis://localhost:6379/0
ML_SERVICE_URL=http://127.0.0.1:8001

# Solana attestation relayer service URL (for on-chain score minting)
# Local development:
RELAYER_SERVICE_URL=http://127.0.0.1:3001
# Production (e.g. Railway):
# RELAYER_SERVICE_URL=https://credlayer-production.up.railway.app

# Reserved for a future Supabase-backed identity provider - not used yet.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
