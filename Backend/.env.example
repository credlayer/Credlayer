# Copy to .env and fill in for local development.

ENVIRONMENT=development
LOG_LEVEL=INFO

API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173"]

# Local PostgreSQL
DATABASE_URL=postgresql+asyncpg://credlayer:credlayer@localhost:5432/credlayer

# Railway PostgreSQL: use the DATABASE_URL Railway provides (postgresql:// is converted to asyncpg automatically).

# Redis is optional - leave empty or omit to disable caching
REDIS_URL=redis://localhost:6379/0
# Required per deployment. For local development only, use http://127.0.0.1:8001.
# Production must point to the deployed ML service URL.
ML_SERVICE_URL=

# Solana attestation relayer service URL (for on-chain score minting)
# Local development:
RELAYER_SERVICE_URL=http://127.0.0.1:3001
# Production (e.g. Railway):
# RELAYER_SERVICE_URL=https://credlayer-production.up.railway.app

# Auth: generate with `openssl rand -hex 32`. Required in production.
JWT_SECRET=
JWT_EXPIRE_MINUTES=1440
# Comma-separated emails that become admins when they register.
ADMIN_EMAILS=
